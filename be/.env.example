# App
DEBUG=false
CORS_ORIGINS=["*"]

# Session pooler (IPv4-friendly): host like aws-0-....pooler.supabase.com, port 5432, user postgres.<project-ref>
# Direct: host db.<ref>.supabase.co,
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=postgres.your_project_ref
DB_PASSWORD=

# Pool tuning (single long-running server)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Supabase — JWT verification uses JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# (requires asymmetric signing keys in the project; see Supabase JWT signing keys docs)
SUPABASE_URL=https://xxxxx.supabase.co
