# App
DEBUG=false
CORS_ORIGINS=["*"]

# Session pooler (IPv4-friendly): host like aws-0-....pooler.supabase.com, port 5432, user postgres.<project-ref>
# Direct: host db.<ref>.supabase.co,
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=postgres.your_project_ref
DB_PASSWORD=

# Pool tuning (single long-running server)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Supabase — JWT verification uses JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# (requires asymmetric signing keys in the project; see Supabase JWT signing keys docs)
SUPABASE_URL=https://xxxxx.supabase.co

# GCS — GCP project that owns the bucket (Console → project selector; fixes "Project was not passed")
GOOGLE_CLOUD_PROJECT=

# GCS event covers (multipart upload). Local: gcloud auth application-default login
GCS_EVENT_COVERS_BUCKET=
# Optional; default ~5 MiB
# GCS_EVENT_COVER_MAX_BYTES=5242880

# GCS profile avatars (separate bucket). Grant object public read if using public URLs in the app.
GCS_PROFILE_AVATARS_BUCKET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=