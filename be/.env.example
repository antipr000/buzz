# App
DEBUG=false
CORS_ORIGINS=["*"]

# Postgres (Supabase: Dashboard → Connect → URI; use async URL pieces for asyncpg)
DB_HOST=db.xxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# Pool tuning (single long-running server)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Supabase — JWT verification uses JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# (requires asymmetric signing keys in the project; see Supabase JWT signing keys docs)
SUPABASE_URL=https://xxxxx.supabase.co
